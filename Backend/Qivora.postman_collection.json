  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\",\n  \"email\": \"{{testEmail}}\",\n  \"fullName\": \"{{testFullName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates a USER account. If you run this multiple times, change testUsername and testEmail to avoid conflict."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 201 or conflict if user already exists\", function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test(\"register returns user data\", function () {",
                  "    pm.expect(json).to.have.property(\"success\", true);",
                  "    pm.expect(json.data).to.have.property(\"username\");",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in and saves accessToken, refreshToken, expiresIn, and roles to collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"login returns JWT data\", function () {",
                  "  pm.expect(json).to.have.property(\"success\", true);",
                  "  pm.expect(json.data).to.have.property(\"accessToken\");",
                  "  pm.expect(json.data).to.have.property(\"refreshToken\");",
                  "});",
                  "",
                  "if (json.data) {",
                  "  pm.collectionVariables.set(\"accessToken\", json.data.accessToken || \"\");",
                  "  pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken || \"\");",
                  "  pm.collectionVariables.set(\"expiresIn\", String(json.data.expiresIn || \"\"));",
                  "  pm.collectionVariables.set(\"roles\", JSON.stringify(json.data.roles || []));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
